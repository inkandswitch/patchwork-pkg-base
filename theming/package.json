{
  "name": "@patchwork/theming",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    "./codemirror/theme": {
      "import": "./dist/codemirror-theme.js",
      "source": "./src/codemirror-theme.ts"
    },
    "./datatypes/theme-preferences": {
      "import": "./dist/datatype.js",
      "source": "./src/datatype.ts"
    },
    "./components/theme-tray": {
      "import": "./dist/theme-tray.js",
      "source": "./src/theme-tray.tsx"
    },
    "./gloom.css": "./gloom.css",
    "./lychee.css": "./lychee.css"
  },
  "patchwork": {
    "plugins": {
      "codemirror:extension": {
        "codemirror-theme": {
          "name": "Theme",
          "supportedDatatypes": "*",
          "export": "./codemirror-theme"
        }
      },
      "patchwork:theme": {
        "lychee": {
          "name": "Lychee",
          "style": "./lychee.css"
        },
        "gloom": {
          "name": "Gloom",
          "style": "./gloom.css"
        }
      },
      "patchwork:datatype": {
        "theme-preferences": {
          "name": "Theme Preferences",
          "icon": "Palette",
          "unlisted": true,
          "export": "./datatypes/theme-preferences"
        }
      },
      "patchwork:component": {
        "theme-tray": {
          "name": "Theme Tray",
          "icon": "Palette",
          "export": "./components/theme-tray",
          "tags": [
            "system-tray"
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild/build.ts",
    "dev": "node esbuild/watch.ts",
    "pushwatch": "pnpm dev pushwork",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.4",
    "@inkandswitch/patchwork-bootloader": "^0.7.2",
    "@inkandswitch/patchwork-plugins": "^1.2.5",
    "@inkandswitch/patchwork-providers": "^0.5.5",
    "@lezer/highlight": "^1.2.1",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/parser": "^7.28.4",
    "@node-types/node": "npm:@types/node@^24.9.1",
    "babel-preset-solid": "^1.9.9",
    "esbuild": "^0.23.1",
    "happy-dom": "^15.11.7",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^3.2.4"
  }
}
