{
  "name": "@patchwork/file",
  "version": "0.0.4",
  "description": "File datatype and viewer for Patchwork",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "pushwork": {
    "url": "automerge:3gH1AZwy53dHX3mqxkdfN875J3HT"
  },
  "allowScripts": {
    "cbor-extract": true,
    "esbuild": true
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "push": "pnpm build && pushwork sync",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\""
  },
  "keywords": [],
  "author": "Ink & Switch",
  "dependencies": {
    "@automerge/automerge": "^3.2.1",
    "@automerge/automerge-repo": "^2.5.0",
    "@inkandswitch/patchwork-elements": "^0.0.5",
    "@inkandswitch/patchwork-filesystem": "^0.0.3",
    "@inkandswitch/patchwork-providers": "^0.3.0",
    "solid-automerge": "^2.0.0",
    "solid-js": "^1.9.11"
  },
  "devDependencies": {
    "@inkandswitch/patchwork-bootloader": "^0.0.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vite-plugin-solid": "^2.10.0"
  }
}
