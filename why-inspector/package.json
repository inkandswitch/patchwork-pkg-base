{
  "name": "@patchwork/why-inspector",
  "title": "Why",
  "version": "0.0.1",
  "description": "Point at anything in the frame and see what it is: which tool or component, from which package, showing which doc, at which heads.",
  "type": "module",
  "main": "./dist/index.js",
